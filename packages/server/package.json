{
  "name": "@coxr/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@coxr/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/websocket": "^11.0.1",
    "@hocuspocus/extension-redis": "^4.0.0",
    "@hocuspocus/server": "^4.0.0",
    "@simplewebauthn/server": "^13.3.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-jwt": "^6.2.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.10.1",
    "mediasoup": "^3.19.21",
    "postgres": "^3.4.9",
    "yjs": "^13.6.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.19.17",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
